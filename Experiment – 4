#Creating Dictionary
student={
"Roll":101,
"Name":"Sriya",
"Branch":"MCA",
"CGPA":8.9
}
print(student)

#Accessing Dictionary Elements
student={
"Roll":101,
"Name":"Sriya",
"CGPA":8.8
}
print(student["Name"])
print(student["CGPA"])

#Adding New Elements
student={
"Roll":101,
"Name":"Sriya"
}
student["Branch"]="MCA"
student["CGPA"]=8.7
print(student)

#Adding New Elements
student={
"Name":"Sriya",
"CGPA":8.4
}
student["CGPA"]=9.1
print(student)

#Delete an Element
student={
"Roll":101,
"Name":"Sriya",
"CGPA":8.9
}
del student["CGPA"]
print(student)

#Dictionary Traversal
student={
"Roll":101,
"Name":"Sriya",
"CGPA":8.8
}
for key,value in student.items():
    print(key,"=",value)

#Employee Database
employee={
101:["Sriya",45000],
102:["Anu",55000],
103:["Vidya",60000]
}
for id,data in employee.items():
    print(id,data)

#Student Marks Database
students={
"Rahul":89,
"Ravi":92,
"Anil":78,
"Keerthi":94
}
highest=max(students,key=students.get)
print("Topper =",highest)
print("Marks =",students[highest])

#Inventory Management
inventory={
"Laptop":25,
"Mouse":80,
"Keyboard":50
}
item=input("Enter Item : ")
if item in inventory:
    print("Stock =",inventory[item])
else:
    print("Item Not Available")

#Nested Dictionary
students={
101:{
"Name":"Rahul",
"CGPA":8.9
},
102:{
"Name":"Ravi",
"CGPA":8.5
}
}
print(students[101]["Name"])
print(students[102]["CGPA"])

